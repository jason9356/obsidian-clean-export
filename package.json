{
  "name": "obsidian-clean-export",
  "version": "1.0.0",
  "description": "Export Obsidian notes to clean PDF and styled DOCX",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "export",
    "pdf",
    "docx"
  ],
  "license": "MIT",
  "dependencies": {
    "docx": "^9.5.0",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
